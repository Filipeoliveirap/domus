# Caminho que o navegador usa (proxy same-origin do Next). Não mudar.
NEXT_PUBLIC_API_URL=/api
# Destino real do Spring, lido só pelo servidor do Next (rewrites).
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ─── Mercado Pago (checkout de evento pago, Task 14) ───────────
# Chave PÚBLICA (não secreta) do Payment Brick, embutida no navegador do pagador pra
# tokenizar o cartão — o número do cartão nunca passa pelo backend do Domus. Pegue no
# painel de credenciais do Mercado Pago (conta da própria plataforma, não da igreja: quem
# efetivamente recebe o pagamento é a conta MP de cada igreja, conectada via OAuth nas
# Tasks 3-5). Sem valor real aqui — só documentando que a variável precisa existir.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ─── Sentry (rastreamento de erro) ─────────────────────────────
# DSN vazio = Sentry desligado (dev). Em prod, setar o DSN do projeto.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=dev
# Só para upload de source maps no build de prod/CI (opcional; ver BACKLOG):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
