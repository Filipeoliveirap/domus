# ─── Banco de dados (Neon) ─────────────────────────────────────
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_MS=600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── E-mail (transacional) ─────────────────────────────────────
# EMAIL_PROVIDER: "log" (imprime no console) ou "resend" (envia de verdade)
EMAIL_PROVIDER=log
EMAIL_FROM=Domus <onboarding@resend.dev>
RESEND_API_KEY=

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ─── CORS ──────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula (ex.: https://app.seudominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limiting ─────────────────────────────────────────────
# Limites por IP, por minuto (opcionais; têm default no application.properties)
RATELIMIT_GLOBAL_POR_MINUTO=100
RATELIMIT_AUTH_POR_MINUTO=10
# Só "true" quando houver proxy/load balancer confiável na frente (produção)
RATELIMIT_TRUST_FORWARDED_FOR=false

# ─── Sentry (rastreamento de erro) ─────────────────────────────
# DSN vazio = Sentry desligado (dev). Em prod, setar o DSN do projeto.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev

# ─── Storage (anexos financeiros) ──────────────────────────────
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ─── Fotos (Cloudflare R2 — bucket privado, servido pela própria API) ──
R2_FOTOS_ENDPOINT=
R2_FOTOS_BUCKET=
R2_FOTOS_ACCESS_KEY=
R2_FOTOS_SECRET_KEY=
# Prazos de limpeza de foto órfã/arquivada (opcionais; têm default no application.properties)
FOTOS_ORFA_HORAS=24
FOTOS_ARQUIVADA_MESES=6

# ─── Pagamento (Mercado Pago) ───────────────────────────────────
# Chave simétrica usada para criptografar access/refresh token da conta MP de cada
# igreja em repouso (CredencialEncryptor) — gere com, por exemplo, `openssl rand -base64 32`.
PAGAMENTO_ENCRYPTION_KEY=<gere-com-openssl-rand-base64-32>
# Credenciais da aplicação OAuth cadastrada no painel de desenvolvedores do Mercado Pago.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Precisa bater exatamente com o redirect_uri cadastrado no painel do Mercado Pago e com
# o usado tanto na URL de autorização quanto na troca do code por tokens.
MERCADOPAGO_REDIRECT_URI=http://localhost:8080/pagamentos/conta/callback
# Segredo usado para validar a assinatura HMAC (header x-signature) do webhook.
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Perfil Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
# Cookies de sessão
COOKIE_SECURE=true
COOKIE_PATH_PREFIX=/api
# Em produção (atrás do proxy do Next): framework. Em dev: none.
FORWARD_HEADERS_STRATEGY=none
