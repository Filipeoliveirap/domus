# ─── Banco de dados (Neon) ─────────────────────────────────────
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_MS=600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── E-mail (transacional) ─────────────────────────────────────
# EMAIL_PROVIDER: "log" (imprime no console) ou "resend" (envia de verdade)
EMAIL_PROVIDER=log
EMAIL_FROM=Domus <onboarding@resend.dev>
RESEND_API_KEY=

# ─── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# ─── CORS ──────────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula (ex.: https://app.seudominio.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate limiting ─────────────────────────────────────────────
# Limites por IP, por minuto (opcionais; têm default no application.properties)
RATELIMIT_GLOBAL_POR_MINUTO=100
RATELIMIT_AUTH_POR_MINUTO=10
# Só "true" quando houver proxy/load balancer confiável na frente (produção)
RATELIMIT_TRUST_FORWARDED_FOR=false

# ─── Storage (anexos financeiros) ──────────────────────────────
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# ─── Perfil Spring ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev